// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING // user signed up but an email is not verified yet
  ACTIVE // active account
  SUSPENDED // temporarily disabled by an administrator
  LOCKED // automatically locked after too many failed login
  DEACTIVATED // user voluntarily deactivated his account. can be reactivated
  DELETED // ineccessible, retained for audit purposes
}

model User {
  id                  String               @id @default(ulid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  status              UserStatus           @default(PENDING)
  emailVerified       Boolean              @default(false) @map("email_verified")
  emailVerifiedAt     DateTime?
  isPlatformAdmin     Boolean              @default(false) @map("is_platform_admin") // true if owner/developer
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  lastLoginAt         DateTime?            @map("last_login_at")
  failedLoginCount    Int                  @default(0)
  lockedAt            DateTime?            @map("locked_at")
  organizationMembers OrganizationMember[]
  sessions            Session[]
  auditLogs           AuditLog[]
  createdInvitations  Invitation[]         @relation("InvitationCreatedBy")
  userToken           UserToken[]

  @@map("user")
}

model Organization {
  id                  String               @id @default(ulid())
  name                String               @unique
  slug                String               @unique // slug name of the company
  taxNo               String               @unique @map("tax_number")
  address             String?
  createdAt           DateTime             @default(now()) @map("created_at")
  roles               Role[]
  organizationMembers OrganizationMember[]
  invitations         Invitation[]
  auditLogs           AuditLog[]

  @@map("organization")
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  roleId         String       @map("role_id")
  role           Role         @relation(fields: [roleId], references: [id])
  status         MemberStatus // user can belong to multiple organizations, and their status can differ in each other
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@map("organization_member")
}

enum RoleNames {
  OWNER
  ADMIN
  MANAGER
  DIRECTOR
  EMPLOYEE
  VIEWER
}

model Role {
  id                  String               @id @default(ulid())
  organizationId      String               @map("organization_id")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                RoleNames            @default(VIEWER)
  description         String
  isSystem            Boolean              @default(false) @map("is_system") // if true the deletion of this record must be impossible, for security reasons
  organizationMembers OrganizationMember[]
  rolePermissions     RolePermission[]
  invitations         Invitation[]

  @@unique([organizationId, name])
  @@map("role")
}

model Permission {
  id              String           @id @default(ulid())
  resource        String // authorization subject like users, invoices, business subjects like resource/svyion -> purchase:po(purchase order) + create, approve or cancel
  action          String // create, view, delete, update, approve, cancel etc
  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model Invitation {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String
  roleId          String       @map("role_id")
  role            Role         @relation(fields: [roleId], references: [id])
  token           String       @unique
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  createdByUserId String?      @map("created_by")
  createdByUser   User?        @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("invitation")
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  ip             String? // ip from where the session opened
  userAgent      String?   @map("user_agent") // browser/mobile/
  lastActivity   DateTime  @map("last_activity")
  expiresAt      DateTime  @map("expires_at") // SESSION ABSOLUTE
  idleExpiresAt  DateTime  @map("idle_expires_at") // SESSION IDLE
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason")
  refreshVersion Int       @default(0) @map("refresh_version")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("session")
}

enum ResourceType {
  USER
  ORGANIZATION
  ROLE
  PERMISSION
  INVITATION
  SESSION
  API_KEY
}

enum AuditAction {
  // Authentication
  LOGIN
  LOGIN_FAILED
  LOGOUT
  REFRESH_TOKEN
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED

  // User
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_DELETED

  // Organization
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED
  ORGANIZATION_TRANSFERRED

  // Membership
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED

  // Roles
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_ASSIGNED
  ROLE_REMOVED

  // Permissions
  PERMISSION_GRANTED
  PERMISSION_REVOKED

  // Security
  MFA_ENABLED
  MFA_DISABLED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  INVITATION
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("user_token")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?       @map("user_id")
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  resource       ResourceType
  resourceId     String?       @map("resource_id")
  metadata       Json?
  ip             String?
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
